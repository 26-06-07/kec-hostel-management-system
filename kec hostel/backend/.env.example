# =============================================================
# KEC Hostels Management System — Backend Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT Authentication ─────────────────────────────────────────
# Keep this secret. Change in production.
JWT_SECRET=kec_hostel_super_secure_jwt_secret_key_2026

# ── MySQL Database (filled in by the Database Teammate) ────────
#
# Steps for the database teammate:
#   1. Create the database:
#        CREATE DATABASE kec_hostel_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   2. Run the schema:
#        mysql -u root -p kec_hostel_db < data/schema.sql
#   3. Fill in the credentials below in your .env file.
#   4. Restart (or wait 15 s for auto-reconnect) — the backend
#      automatically switches from in-memory fallback to MySQL.
#
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=kec_hostel_db

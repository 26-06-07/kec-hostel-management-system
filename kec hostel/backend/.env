# =============================================================
# KEC Hostels Management System — Backend Environment Variables
# =============================================================

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT Authentication ─────────────────────────────────────────
JWT_SECRET=kec_hostel_super_secure_jwt_secret_key_2026

# ── MySQL Database ─────────────────────────────────────────────
# Database teammate: fill in DB_PASSWORD (and DB_USER if different).
# Once MySQL is running with correct credentials, the backend
# auto-connects within 15 seconds — no server restart needed.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kec_hostel_db
